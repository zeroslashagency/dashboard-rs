# Server listening port (AI Studio uses 3000)
PORT=3000

# Optional overrides matching the original dashboard server
# VMC_DASH_PORT=3000
# VMC_TV_ROOT=
# VMC_TV_PORT=3000

# Collector API port published to the browser via /config.js
VMC_COLLECTOR_PORT=9994
# VMC_API_PORT=9994

# Built-in 8-machine VMC demo collector (set to 0 to disable and use external collector)
VMC_DEMO_MODE=1

# Optional override for the static web assets directory
# VMC_DASH_APP_ROOT=./web
